# Copy to .env and fill in. .env is gitignored; these are account credentials.

# Where the built site reads page images, art and PDFs from. The deployed site
# gets this from netlify.toml; set it here only to point a LOCAL build at the
# bucket. Leave it unset for local dev and the local-assets integration serves
# ../site-assets at /_assets instead. No trailing slash.
# PUBLIC_ASSET_BASE=https://pub-xxxxxxxxxxxxxxxx.r2.dev

# Cloudflare R2, for pipeline/upload_assets.mjs only. The site never sees these.
# Account ID: Cloudflare dashboard -> R2 -> Account details.
# Keys: R2 -> API -> Manage API tokens -> Create token, Object Read & Write,
# scoped to this one bucket.
R2_ACCOUNT_ID=
R2_BUCKET=dvij-assets
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Analytics (design §18.12). Netlify Analytics needs nothing here - it counts
# server-side, with no script and no cookie. A privacy-friendly script instead
# (Plausible, GoatCounter, Umami, Fathom) needs its tag:
# PUBLIC_ANALYTICS_SRC=https://plausible.io/js/script.js
# PUBLIC_ANALYTICS_DOMAIN=yourdomain.com
