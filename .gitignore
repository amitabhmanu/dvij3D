# Book source material: manuscripts, print PDFs and chapter art.
# Too large for GitHub (many files over 100 MB) and not meant for a public repo.
/book/
/images/

# Large site assets live in Cloudflare R2 (see site/netlify.toml), not in git.
/site-assets/master/
/site-assets/pages/
/site-assets/pdf/

# Rendered teaser media (regenerate with teaser/make_teaser.py)
/teaser/*.mp4
/teaser/*.gif

# Secrets
.env
.env.*
!.env.example

# Dependencies, build output, caches
node_modules/
dist/
.astro/
.netlify/
__pycache__/
*.pyc
test-results/
playwright-report/

# Local Claude Code permissions (machine-specific paths)
.claude/settings.local.json

# OS / editor
.DS_Store
Thumbs.db
.vscode/

# Pipeline review images (regenerated by each step)
/site/pipeline/reports/*.png

# Scratch builds (the lodge's Blender inputs)
/site/pipeline/.build/
