---
// The tattvas as the book's own "periodic table": seven groups of five, each
// cell a tattva and the Devanagari letter assigned to it, read from the table
// in src/content/codex/tattvas.md. Groups run subtlest first.
//
// The letters were set in a legacy font in the manuscript and are decoded by
// pipeline/legacy_devanagari.py. One cell, the kanchuka of Fate, has no
// recoverable letter; it shows a dash rather than a guess.
type Cell = { name: string; letter: string | null };
const GROUPS: { name: string; cells: Cell[] }[] = [
  { name: "Shuddha-tattvas", cells: [["Kriya", "श"], ["Gyana", "ष"], ["Ichhna", "स"], ["Shakti", "ह"], ["Shiva", "क्ष"]] as any },
  { name: "Kanchukas", cells: [["Action", "य"], ["Knowledge", "र"], ["Desire", "ल"], ["Time", "व"], ["Fate", null]] as any },
  { name: "Antahkarnas", cells: [["Prakriti", "प"], ["Ahamkara", "फ"], ["Buddhi", "ब"], ["Manas", "भ"], ["Purusha", "म"]] as any },
  { name: "Gyanendriyas", cells: [["Smelling", "त"], ["Tasting", "थ"], ["Seeing", "द"], ["Feeling", "ध"], ["Hearing", "न"]] as any },
  { name: "Karmendriyas", cells: [["Excreting", "ट"], ["Sexing", "ठ"], ["Grasping", "ड"], ["Moving", "ढ"], ["Speaking", "ण"]] as any },
  { name: "Tanmatas", cells: [["Scent", "च"], ["Taste", "छ"], ["Sight", "ज"], ["Touch", "झ"], ["Sound", "ञ"]] as any },
  { name: "Mahabhutas", cells: [["Earth", "क"], ["Water", "ख"], ["Fire", "ग"], ["Air", "घ"], ["Ether", "ङ"]] as any },
].map((g) => ({ name: g.name, cells: (g.cells as unknown as [string, string | null][]).map(([name, letter]) => ({ name, letter })) }));

const CW = 55, CH = 38, X0 = 11, LABEL_H = 15, BLOCK = LABEL_H + CH + 9;
const Y0 = 14;
const VB_H = Y0 + GROUPS.length * BLOCK + 18;
---

<figure class="diagram">
  <svg viewBox={`0 0 300 ${VB_H}`} role="img" aria-labelledby="tat-t tat-d">
    <title id="tat-t">The periodic table of the tattvas</title>
    <desc id="tat-d">
      Seven groups of five principles, subtlest first, each with the Devanagari letter
      the book assigns it. Shuddha-tattvas take the sibilants, the kanchukas the
      semivowels, and the five pentads below them take the five vargas in turn, ending
      with the gross elements on ka-varga. The kanchuka of Fate has no recoverable
      letter and shows a dash.
    </desc>

    {GROUPS.map((g, i) => {
      const y = Y0 + i * BLOCK;
      return (
        <g>
          <rect class="swatch" x={X0} y={y - 9} width="4" height="10" style={`fill-opacity:${0.3 + i * 0.1}`} />
          <text class="g-name" x={X0 + 10} y={y}>{g.name}</text>
          {g.cells.map((c, k) => {
            const x = X0 + k * (CW + 1);
            return (
              <g>
                <rect class={c.letter ? "cell" : "cell gap"} x={x} y={y + 6} width={CW} height={CH} rx="3" />
                <text class={c.letter ? "letter" : "letter missing"} x={x + CW / 2} y={y + 27} text-anchor="middle">
                  {c.letter ?? "—"}
                </text>
                <text class="c-name" x={x + CW / 2} y={y + 39} text-anchor="middle">{c.name}</text>
              </g>
            );
          })}
        </g>
      );
    })}

    <text class="d-foot" x="150" y={VB_H - 5} text-anchor="middle">subtle above · gross below</text>
  </svg>
  <figcaption>
    The book's own table: each tattva with its Devanagari letter. The groups take the
    alphabet in order — sibilants for the shuddha-tattvas, semivowels for the
    kanchukas, then a varga per pentad down to the gross elements on <span class="dv">क ख ग घ ङ</span>.
    Fate's letter is not recoverable from the manuscript, so it shows a dash.
  </figcaption>
</figure>

<style>
  .cell { fill: var(--paper); stroke: var(--paper-3); stroke-width: 1; }
  .gap { stroke-dasharray: 3 3; }
  .letter { font-family: var(--font-deva); font-size: 17px; fill: var(--ink); }
  .missing { fill: var(--ink-3); font-size: 13px; }
  .c-name { font-family: var(--font-ui); font-size: 7.2px; fill: var(--ink-3); }
  .g-name { font-family: var(--font-text); font-size: 11px; font-weight: 700; fill: var(--ink-2); }
  .swatch { fill: var(--sepia); }
  .dv { font-family: var(--font-deva); }
</style>
