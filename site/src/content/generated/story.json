     "do": [
      {
       "actor": {
        "who": "professor",
        "look": "veena",
        "anim": "interact"
       }
      },
      {
       "say": {
        "who": "professor",
        "line": "The veena... ah... it is safe. Of course I do not play it. No... no... I am no good with music. It's the inspiration that I keep it with me all the time... after all it is the instrument of the Goddess of learning, no?"
       }
      },
      {
       "prop": {
        "id": "veena",
        "state": "upright"
       }
      },
      {
       "say": {
        "who": "professor",
        "line": "You were trying to reach up for those books, eh? And fell backwards. Was that it? It happens to me all the time. I don't cause as much damage though.",
        "sources": [
         "novel ¶143"
        ]
       }
      },
      {
       "say": {
        "who": "dvij",
        "line": "I... I fainted. My head... it's bandaged.",
        "sources": [
         "novel ¶144"
        ]
       }
      }
     ]
    },
    {
     "id": "varahi",
     "sources": [
      "breakdown ch3 p5",
      "breakdown ch3 p6",
      "novel ¶145-149"
     ],
     "act": {
      "objective": "Pick up the broken figurine.",
      "kind": "look-press",
      "target": "varahi"
     },
     "then": [
      {
       "say": {
        "who": "dvij",
        "line": "I'm sorry.",
        "sources": [
         "novel ¶146"
        ]
