---
// Dev-only: the people lab (src/lib/story/lab.ts). getStaticPaths returns nothing in production, so it is never
// built or deployed. Run the dev server and open /dev/lab/people; driven by pipeline/likeness/render.mjs.
export function getStaticPaths() {
  return import.meta.env.DEV ? [{ params: { tool: "people" } }] : [];
}
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>People lab (dev)</title>
  </head>
  <body style="margin:0;background:#222">
    <canvas id="lab" width="768" height="768"></canvas>
    <script>
      import { startLab } from "../../../lib/story/lab";
      startLab(document.getElementById("lab") as HTMLCanvasElement);
      document.body.dataset.ready = "1";
    </script>
  </body>
</html>
