---
// Walking the valley (design §10.2): a full-screen game page, without the
// site's header and footer. All it loads at first is the start screen.
import Base from "../../layouts/Base.astro";
import Walk from "../../islands/Walk.tsx";
import { artFile, books, pick, walkFile } from "../../lib/manifest";
import story from "../../content/generated/story.json";
import { located } from "../../lib/places";
import { walk } from "../../lib/walk/walk-data";
// The 8 places the map labels, for the walk's prompts, cards and fast travel.
const places = located.map((p) => ({
  id: p.id, name: p.name, fiction: p.fiction, book: p.book,
  firstSeen: p.pages[0] ? { book: p.pages[0].book, page: p.pages[0].page } : null,
  real: { name: p.real.name, pin: p.real.pin, region: p.real.region, why: p.real.why },
  pages: p.pages.map((pg) => ({ book: pg.book, page: pg.page })),
}));
// The comic pages story mode shows (its interludes and the reflection), with their panels' boxes.
const storyPages = Object.fromEntries(
  [...new Set(JSON.stringify(story).match(/"b\d+-p\d{3}(?=["-])/g)!.map((m) => m.slice(1)))].map((id) => {
    const pg = books.find((b) => b.book === Number(id.slice(1, id.indexOf("-"))))!.pages.find((x) => x.id === id)!;
    return [id, { src: pick(pg.src.webp, 1400), w: pg.w, h: pg.h, panels: pg.panels }];
  }),
);
---
<Base
  title="Walk the valley"
  description="Walk through the valley of The Twice Born in first person, from the Access Road to the top of Mount Dronagiri, built from the book's own map."
  chrome={false}
  bodyClass="walk-page"
>
  <Walk client:only="preact" heightUrl={walkFile(walk.height.file)} worldUrl={walkFile(walk.world)}
    groundUrl={walkFile(walk.ground)} mapUrl={artFile("valley-map.webp")} backUrl="/valley/" places={places} storyPages={storyPages} />
  <noscript><p class="walk-noscript">Walking the valley needs JavaScript. <a href="/valley/">The book's map</a> works without it.</p></noscript>
</Base>

<style is:global>
  body.walk-page { margin: 0; overflow: hidden; background: #2b241c; }
  body.walk-page .skip-link { display: none; }
  .walk { position: fixed; inset: 0; font-family: var(--font-ui); color: var(--ink); user-select: none; }
  .walk-canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; touch-action: none; }
  .walk .card { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); width: min(440px, calc(100% - 32px));
    box-sizing: border-box; padding: 26px 28px; border-radius: 12px; background: rgb(245 236 218 / 96%);
    box-shadow: 0 18px 60px rgb(0 0 0 / 35%); text-align: left; max-height: calc(100% - 32px); overflow: auto; }
  .walk .card h1 { font-family: var(--font-display); font-size: 2.3rem; margin: 2px 0 10px; }
  .walk .card h2 { font-size: 1.15rem; margin: 0 0 14px; }
  .walk .card p { margin: 0 0 14px; font: 0.95rem/1.5 var(--font-body); color: var(--ink-2); }
  .walk .eyebrow { margin: 0; font: 700 0.72rem var(--font-ui) !important; letter-spacing: 0.12em; text-transform: uppercase; color: var(--sepia) !important; }
  .walk .go { display: block; width: 100%; margin: 6px 0 16px; padding: 13px 18px; border: 0; border-radius: 8px;
    background: var(--ink); color: var(--paper); font: 600 1rem var(--font-ui); cursor: pointer; }
  .walk .go:hover, .walk .go:focus-visible { background: var(--accent); outline: none; }
  .walk .back { margin: 12px 0 0 !important; font: 0.88rem var(--font-ui) !important; }
  .walk .back a { color: var(--accent); }
  .walk .controls { display: grid; grid-template-columns: auto 1fr; gap: 4px 14px; margin: 0; font-size: 0.84rem; color: var(--ink-2); }
  .walk .controls dt { font-weight: 600; color: var(--ink); }
  .walk .controls dd { margin: 0; }
  .walk .bar { height: 8px; border-radius: 4px; background: var(--paper-3); overflow: hidden; }
  .walk .bar span { display: block; height: 100%; background: var(--accent); transition: width 0.2s; }
  .walk .begin { border: 0; cursor: pointer; text-align: center; display: grid; gap: 6px; font: 0.95rem var(--font-ui); color: var(--ink-2); }
  .walk .begin strong { font-size: 1.1rem; color: var(--ink); }
  .walk .pause label { display: grid; gap: 4px; margin: 0 0 12px; font-size: 0.86rem; font-weight: 600; }
  .walk .pause label.check { display: flex; align-items: center; gap: 8px; font-weight: 400; }
  .walk .pause select, .walk .pause input[type="range"] { width: 100%; }
  .walk .pause-btn { position: absolute; top: 14px; right: 14px; width: 40px; height: 40px; border-radius: 50%; border: 0;
    background: rgb(245 236 218 / 80%); font: 700 0.9rem var(--font-ui); cursor: pointer; }
  .walk .stick { position: absolute; left: 28px; bottom: 28px; width: 120px; height: 120px; border-radius: 50%;
    background: rgb(245 236 218 / 25%); border: 2px solid rgb(245 236 218 / 55%); touch-action: none; }
  .walk .stick span { position: absolute; left: 35px; top: 35px; width: 50px; height: 50px; border-radius: 50%;
    background: rgb(245 236 218 / 85%); }
  .walk .hud { position: absolute; inset: 0; pointer-events: none; }
  .walk .hud button { pointer-events: auto; }
  .walk .compass { position: absolute; top: 12px; left: 50%; width: min(440px, 70vw); height: 30px; transform: translateX(-50%);
    overflow: hidden; border-radius: 15px; background: rgb(43 36 28 / 55%); color: #efe3c8;
    mask-image: linear-gradient(90deg, transparent, #000 18%, #000 82%, transparent); }
  .walk .compass .strip { position: absolute; left: 50%; top: 0; height: 100%; }
  .walk .compass .strip span { position: absolute; top: 6px; transform: translateX(-50%); font: 600 0.72rem var(--font-ui); opacity: 0.75; }
  .walk .compass .strip span.major { font-size: 0.9rem; opacity: 1; top: 4px; }
  .walk .compass .pointer { position: absolute; left: 50%; bottom: 0; width: 2px; height: 8px; background: #e9b77f; }
  .walk .minimap { position: absolute; right: 14px; bottom: 14px; width: min(220px, 34vw); border-radius: 8px; overflow: hidden;
    border: 2px solid rgb(245 236 218 / 85%); background: #fff; box-shadow: 0 6px 20px rgb(0 0 0 / 30%); }
  .walk .minimap img, .walk .map-frame img { display: block; width: 100%; height: auto; }
  .walk .me { position: absolute; width: 0; height: 0; border-left: 6px solid transparent; border-right: 6px solid transparent;
    border-bottom: 14px solid #b6402c; transform: translate(-50%, -50%); filter: drop-shadow(0 0 2px #fff); }
  .walk .prompt { position: absolute; left: 50%; bottom: 18%; transform: translateX(-50%); border: 0; border-radius: 999px;
    padding: 10px 18px; background: rgb(245 236 218 / 94%); font: 600 0.95rem var(--font-ui); color: var(--ink); cursor: pointer; }
  .walk .prompt kbd { display: inline-block; min-width: 1.4em; margin-right: 6px; padding: 1px 6px; border-radius: 4px;
    background: var(--ink); color: var(--paper); font: 700 0.8rem var(--font-ui); }
  .walk .map-btn { position: absolute; top: 14px; right: 62px; width: 40px; height: 40px; border-radius: 50%; border: 0;
    background: rgb(245 236 218 / 80%); font: 700 0.9rem var(--font-ui); cursor: pointer; }
  .walk .place-card .fiction { font: 0.9rem var(--font-ui) !important; color: var(--sepia) !important; }
  .walk .place-card .book, .walk .place-card .why { font-size: 0.95rem; }
  .walk .place-card .pages { font: 0.85rem var(--font-ui) !important; }
  .walk .place-card .pages a { color: var(--accent); }
  .walk .veil-notice { margin: 0 0 14px; padding: 10px 12px; border-radius: 8px; background: var(--paper-2); font: 0.9rem/1.5 var(--font-ui); }
  .walk .veil-notice .acts { display: block; }
  .walk .veil-notice button { margin: 6px 6px 0 0; padding: 4px 10px; border-radius: 6px; border: 1px solid var(--paper-3);
    background: var(--paper); font: 600 0.82rem var(--font-ui); cursor: pointer; }
  .walk .big-map { width: min(900px, calc(100% - 32px)); }
  .walk .map-frame { position: relative; border-radius: 8px; overflow: hidden; margin-bottom: 10px; }
  .walk .map-frame .spot { position: absolute; transform: translate(-50%, -50%); border: 0; border-radius: 999px; padding: 3px 9px;
    background: var(--ink); color: var(--paper); font: 600 0.74rem var(--font-ui); cursor: pointer; white-space: nowrap; }
  .walk .map-frame .spot:disabled { background: rgb(120 110 100 / 75%); cursor: not-allowed; }
  .walk .map-frame .spot:not(:disabled):hover, .walk .map-frame .spot:focus-visible { background: var(--accent); }
  .walk .hint { font: 0.85rem var(--font-ui) !important; color: var(--sepia) !important; }
  /* story mode (design §10.4) */
  .walk .go.quiet { background: var(--paper-2); color: var(--ink); }
  .walk .go.quiet:hover, .walk .go.quiet:focus-visible { background: var(--paper-3); }
  .walk a.go { box-sizing: border-box; text-align: center; text-decoration: none; }
  .walk .story-start { margin: 4px 0 14px; padding-top: 12px; border-top: 1px solid var(--paper-3); }
  .walk .story-start p:not(.eyebrow) { margin: 4px 0 8px; }
  .walk .story button { pointer-events: auto; }
  .walk .objective { position: absolute; top: 14px; left: 50%; transform: translateX(-50%); max-width: calc(100% - 140px);
    border: 0; border-radius: 999px; padding: 8px 16px; background: rgb(43 36 28 / 70%); color: #efe3c8;
    font: 600 0.95rem var(--font-ui); cursor: pointer; }
  .walk .objective[data-ready] { background: rgb(245 236 218 / 95%); color: var(--ink); }
  .walk .objective kbd, .walk .skip kbd { display: inline-block; min-width: 1.3em; padding: 0 5px; border-radius: 4px;
    background: var(--ink); color: var(--paper); font: 700 0.78rem var(--font-ui); }
  .walk .story-hint { position: absolute; top: 58px; left: 50%; transform: translateX(-50%); margin: 0; padding: 5px 12px;
    border-radius: 6px; background: rgb(43 36 28 / 55%); color: #efe3c8; font: 0.85rem var(--font-ui); white-space: nowrap; }
  .walk .words { position: absolute; left: 50%; bottom: 8%; transform: translateX(-50%); width: min(760px, calc(100% - 32px));
    border: 0; padding: 0; background: none; text-align: center; cursor: pointer; display: grid; gap: 8px; }
  .walk .words .caption { display: block; padding: 12px 18px; border-radius: 4px; background: rgb(245 236 218 / 94%); color: var(--ink);
    font: italic 1.05rem/1.5 var(--font-body); box-shadow: 0 4px 0 rgb(43 36 28 / 60%); }
  .walk .words .subtitle { display: block; padding: 8px 14px; color: #fff; font: 1.1rem/1.45 var(--font-ui);
    text-shadow: 0 1px 3px #000, 0 0 10px rgb(0 0 0 / 80%); }
  .walk .words .subtitle b { color: #e9b77f; }
  .walk .skip { position: absolute; bottom: 14px; right: 14px; border: 0; border-radius: 999px; padding: 6px 12px;
    background: rgb(43 36 28 / 55%); color: #efe3c8; font: 600 0.8rem var(--font-ui); cursor: pointer; }
  .walk .story-overlay { position: absolute; inset: 0; border: 0; padding: 16px; display: grid; place-items: center; cursor: pointer;
    background: rgb(20 16 12 / 92%); color: #efe3c8; font: inherit; }
  .walk .story-overlay.reflection { background: rgb(20 16 12 / 55%); }
  .walk .chapter-card { display: grid; gap: 10px; text-align: center; }
  .walk .chapter-card strong { font: 2.6rem var(--font-display); }
  .walk .chapter-card em { font: italic 1.1rem var(--font-body); opacity: 0.85; }
  .walk .comic-page { display: grid; gap: 8px; justify-items: center; max-height: 100%; }
  .walk .comic-page img { max-height: calc(100vh - 70px); max-width: 100%; width: auto; height: auto; box-shadow: 0 10px 40px #000; }
  .walk .comic-page .turn { font: 0.85rem var(--font-ui); opacity: 0.8; }
  .walk .reflection-frame { position: relative; display: block; width: min(560px, 80vw); overflow: hidden; border: 10px solid #3a2a1c;
    box-shadow: 0 10px 40px #000; }
  .walk .reflection-frame img { position: absolute; max-width: none; height: auto; }
  @media (max-width: 640px) {
    .walk .minimap { width: 38vw; bottom: auto; top: 54px; }
  }
  .walk-noscript { color: #efe3c8; padding: 2rem; font-family: var(--font-ui); }
  .walk-noscript a { color: #e9b77f; }
</style>
